# ------------------------------------------------------------------------------
# CarBroz Application Environment Variables
# ENVIRONMENT: Example
# DO NOT COMMIT SECRETS TO THIS FILE
# ------------------------------------------------------------------------------

# --- App Config ---
# Environment: 'development', 'test', 'production'
NODE_ENV=development
# API Port
PORT=3000
# API Host
HOST=0.0.0.0

# --- Logging Config ---
# Log level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=debug

# --- Database Config ---
# PostgreSQL connection string (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carbroz?schema=public

# --- Redis Config ---
# Redis connection string
REDIS_URL=redis://localhost:6379

# --- JWT Config ---
# Secret for signing JWTs (Must be min 16 characters in production)
JWT_SECRET=super_secret_jwt_key_example
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=carbroz.com
JWT_AUDIENCE=carbroz-users

# --- Providers Config ---
# MinIO configuration (S3 Compatible Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Security Config ---
# Allowed CORS origins
CORS_ORIGIN=*
# Rate limiting maximum requests per window
RATE_LIMIT_MAX=100
# Rate limiting window in milliseconds (default 1 min)
RATE_LIMIT_WINDOW_MS=60000
