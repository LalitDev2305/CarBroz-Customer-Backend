{
  "name": "carbroz-backend-workspace",
  "version": "1.0.0",
  "description": "CarBroz Backend Platform Workspace",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter backend-api dev",
    "start": "pnpm --filter backend-api start",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
