# ------------------------------------------------------------------------------
# CarBroz Application Environment Variables
# ENVIRONMENT: Example
# DO NOT COMMIT SECRETS TO THIS FILE
# ------------------------------------------------------------------------------

# --- App Config ---
# Environment: 'development', 'test', 'production'
NODE_ENV=development
# API Port
PORT=3000
# API Host
HOST=0.0.0.0

# --- Logging Config ---
# Log level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=debug

# --- Database Config ---
# PostgreSQL connection string (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carbroz?schema=public

# --- Redis Config ---
# Redis connection string
REDIS_URL=redis://localhost:6379

# --- JWT Config ---
# Secret for signing JWTs (Must be at least 32 characters)
JWT_SECRET=replace_with_a_long_random_jwt_secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=carbroz.com
JWT_AUDIENCE=carbroz-users

# --- Providers Config ---
# MinIO configuration (S3 Compatible Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key

# MSG91 credentials/template used by the production OTP delivery adapter.
MSG91_AUTH_KEY=replace_with_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=replace_with_msg91_otp_template_id
# Exact variable key configured in the MSG91 Flow template, for example OTP or otp.
MSG91_OTP_VARIABLE_NAME=otp

# Google Maps server-side provider credential. Never store this in persisted business Configuration.
MAPS_API_KEY=replace_with_google_maps_api_key

# Razorpay production credentials. Production rejects test/dummy values.
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret

# --- Security Config ---
# Allowed CORS origins
CORS_ORIGIN=*
# Rate limiting maximum requests per window
RATE_LIMIT_MAX=100
# Rate limiting window in milliseconds (default 1 min)
RATE_LIMIT_WINDOW_MS=60000
