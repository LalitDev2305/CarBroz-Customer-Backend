generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  publicId        String           @unique @default(uuid())
  email           String?          @unique
  phoneNumber     String?          @unique
  isGuest         Boolean          @default(false)
  isAdmin         Boolean          @default(false)
  role            String           @default("USER")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  sessions        UserSession[]
  adminRoles      AdminUserRole[]
  partnerMembers  PartnerMember[]
  uploadedKycs    KycDocument[]    @relation("KycUploader")
  verifiedKycs    KycDocument[]    @relation("KycVerifier")
  customerProfile CustomerProfile?
  addresses       Address[]
  deviceTokens    DeviceToken[]
}

model Role {
  id          Int              @id @default(autoincrement())
  publicId    String           @unique @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  permissions RolePermission[]
  adminUsers  AdminUserRole[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  publicId    String           @unique @default(uuid())
  key         String           @unique
  module      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AdminUserRole {
  userId     Int
  roleId     Int
  assignedBy Int?
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  token     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model UserSession {
  id           Int       @id @default(autoincrement())
  publicId     String    @unique @default(uuid())
  userId       Int
  deviceId     String
  deviceModel  String?
  osVersion    String?
  fcmToken     String?
  refreshToken String?
  isRevoked    Boolean   @default(false)
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
}

model SystemConfig {
  id          Int       @id @default(autoincrement())
  publicId    String    @unique @default(uuid())
  key         String    @unique
  value       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model FeatureFlag {
  id          Int       @id @default(autoincrement())
  publicId    String    @unique @default(uuid())
  key         String    @unique
  enabled     Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Partner {
  id           Int             @id @default(autoincrement())
  publicId     String          @unique @default(uuid())
  businessName String
  type         String
  status       String          @default("PENDING")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  members      PartnerMember[]
  profile      PartnerProfile?
  kycDocuments KycDocument[]
  bookings         Booking[]
  payouts          PartnerPayout[]
  trackingSessions TrackingSession[]
}

model PartnerMember {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @default(uuid())
  userId    Int
  partnerId Int
  role      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([userId, partnerId])
}

model PartnerProfile {
  id           Int      @id @default(autoincrement())
  publicId     String   @unique @default(uuid())
  partnerId    Int      @unique
  description  String?
  logoUrl      String?
  supportEmail String?
  supportPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model KycDocument {
  id              Int      @id @default(autoincrement())
  publicId        String   @unique @default(uuid())
  partnerId       Int
  type            String
  fileUrl         String
  status          String   @default("PENDING")
  rejectionReason String?
  uploadedById    Int
  verifiedById    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partner    Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("KycUploader", fields: [uploadedById], references: [id])
  verifiedBy User?   @relation("KycVerifier", fields: [verifiedById], references: [id])
}

model CustomerProfile {
  id             Int       @id @default(autoincrement())
  publicId       String    @unique @default(uuid())
  userId         Int       @unique
  firstName      String?
  lastName       String?
  dateOfBirth    DateTime?
  gender         String?
  marketingOptIn Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles         Vehicle[]
  bookings         Booking[]
  payments         Payment[]
  trackingSessions TrackingSession[]
}

model Address {
  id           Int       @id @default(autoincrement())
  publicId     String    @unique @default(uuid())
  userId       Int
  label        String? // e.g. "Home", "Work"
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model ServiceCategory {
  id          Int       @id @default(autoincrement())
  publicId    String    @unique @default(uuid())
  name        String
  slug        String    @unique
  description String?
  iconUrl     String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  services    Service[]
}

model Service {
  id                       Int                    @id @default(autoincrement())
  publicId                 String                 @unique @default(uuid())
  categoryId               Int
  name                     String
  slug                     String                 @unique
  description              String?
  imageUrl                 String?
  basePrice                Int // Stored in cents (e.g. 5000 = $50.00 / 5000 INR)
  estimatedDurationMinutes Int                    @default(60)
  isActive                 Boolean                @default(true)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  deletedAt                DateTime?
  category                 ServiceCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  addons                   ServiceAddon[]
  pricingTiers             PricingTier[]
  vehicleMultipliers       VehicleTypeMultiplier[]
  bookings                 Booking[]
}

model ServiceAddon {
  id          Int       @id @default(autoincrement())
  publicId    String    @unique @default(uuid())
  serviceId   Int
  name        String
  description String?
  price       Int // Stored in cents
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model PricingTier {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique @default(uuid())
  serviceId   Int
  name        String // e.g. "Standard", "Premium", "Peak Hours"
  flatPrice   Int // Base or override flat price in cents
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model VehicleTypeMultiplier {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique @default(uuid())
  serviceId   Int
  vehicleType String // e.g. "HATCHBACK", "SEDAN", "SUV", "LUXURY"
  multiplier  Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, vehicleType])
}

enum SduiScreenStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model SduiScreen {
  id                 Int              @id @default(autoincrement())
  publicId           String           @unique @default(uuid())
  screenId           String
  targetApp          String           @default("CUSTOMER")
  versionNumber      Int              @default(1)
  status             SduiScreenStatus @default(DRAFT)
  layoutJson         Json
  lockVersion        Int              @default(1)
  publishedAt        DateTime?
  publishedBy        String?
  createdFromVersion Int?
  changeDescription  String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  @@unique([screenId, targetApp, versionNumber])
  @@index([screenId, targetApp, status])
}

model SduiTemplate {
  id                Int      @id @default(autoincrement())
  publicId          String   @unique @default(uuid())
  templateId        String   @unique
  templateType      String
  defaultLayoutJson Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SduiComponentRegistry {
  id                  Int      @id @default(autoincrement())
  publicId            String   @unique @default(uuid())
  name                String   @unique
  nodeLevel           String   @default("COMPONENT")
  componentType       String
  schemaJson          Json
  supportedProperties Json?
  supportedActions    Json?
  version             Int      @default(1)
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum VehicleStatus {
  ACTIVE
  ARCHIVED
}

enum BookingStatus {
  CREATED
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

model Vehicle {
  id                 Int           @id @default(autoincrement())
  publicId           String        @unique @default(uuid())
  customerId         Int           @map("customer_id")
  make               String
  model              String
  variant            String?
  year               Int
  registrationNumber String        @map("registration_number")
  fuelType           String        @map("fuel_type")
  color              String?
  nickname           String?
  isDefault          Boolean       @default(false) @map("is_default")
  status             VehicleStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([customerId, registrationNumber])
  @@index([customerId, status])
  @@map("vehicles")
}

model Booking {
  id                 Int           @id @default(autoincrement())
  publicId           String        @unique @default(uuid())
  customerId         Int           @map("customer_id")
  partnerId          Int?          @map("partner_id")
  vehicleId          Int           @map("vehicle_id")
  addressId          Int           @map("address_id")
  serviceId          Int           @map("service_id")
  status             BookingStatus @default(CREATED)
  slotStartTime      DateTime      @map("slot_start_time")
  slotEndTime        DateTime      @map("slot_end_time")
  expiryAt           DateTime?     @map("expiry_at")
  totalPricePaise    Int           @map("total_price_paise")
  cancellationReason String?       @map("cancellation_reason")
  snapshotsJson      Json          @map("snapshots_json")
  statusHistoryJson  Json          @map("status_history_json")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  partner  Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  vehicle  Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  address  Address         @relation(fields: [addressId], references: [id], onDelete: Restrict)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  payments         Payment[]
  invoice          Invoice?
  payout           PartnerPayout?
  trackingSession  TrackingSession?
  notificationLogs NotificationLog[]

  @@index([customerId, status])
  @@index([partnerId, status])
  @@index([partnerId, slotStartTime, slotEndTime])
  @@index([status, expiryAt])
  @@map("bookings")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
  CASH_ON_DELIVERY
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

enum PayoutStatus {
  SCHEDULED
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model Payment {
  id                Int           @id @default(autoincrement())
  publicId          String        @unique @default(uuid())
  bookingId         Int           @map("booking_id")
  customerId        Int           @map("customer_id")
  provider          String        @default("RAZORPAY")
  providerOrderId   String?       @unique @map("provider_order_id")
  providerPaymentId String?       @unique @map("provider_payment_id")
  amountPaise       Int           @map("amount_paise")
  currency          String        @default("INR")
  method            PaymentMethod @default(UPI)
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String        @unique @map("idempotency_key")
  attemptsJson      Json          @default("[]") @map("attempts_json")
  refundsJson       Json          @default("[]") @map("refunds_json")
  failureCode       String?       @map("failure_code")
  failureReason     String?       @map("failure_reason")
  paidAt            DateTime?     @map("paid_at")
  failedAt          DateTime?     @map("failed_at")
  refundedAt        DateTime?     @map("refunded_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  lockVersion       Int           @default(1) @map("lock_version")

  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([bookingId, status])
  @@index([customerId, status])
  @@map("payments")
}

model PaymentWebhook {
  id               Int      @id @default(autoincrement())
  publicId         String   @unique @default(uuid())
  provider         String
  eventId          String   @map("event_id")
  eventType        String   @map("event_type")
  payloadHash      String   @map("payload_hash")
  processingStatus String   @default("PENDING") @map("processing_status")
  receivedAt       DateTime @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")
  failureReason    String?  @map("failure_reason")
  retryCount       Int      @default(0) @map("retry_count")

  @@unique([provider, eventId])
  @@index([processingStatus, receivedAt])
  @@map("payment_webhooks")
}

model Invoice {
  id            Int           @id @default(autoincrement())
  publicId      String        @unique @default(uuid())
  bookingId     Int           @unique @map("booking_id")
  invoiceNumber String        @unique @map("invoice_number")
  status        InvoiceStatus @default(ISSUED)
  amountPaise   Int           @map("amount_paise")
  currency      String        @default("INR")
  documentJson  Json          @map("document_json")
  issuedAt      DateTime      @default(now()) @map("issued_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@map("invoices")
}

model PartnerPayout {
  id                   Int          @id @default(autoincrement())
  publicId             String       @unique @default(uuid())
  bookingId            Int          @unique @map("booking_id")
  partnerId            Int          @map("partner_id")
  status               PayoutStatus @default(SCHEDULED)
  grossAmountPaise     Int          @map("gross_amount_paise")
  commissionPaise      Int          @map("commission_paise")
  tdsPaise             Int          @map("tds_paise")
  netPayoutPaise       Int          @map("net_payout_paise")
  calculationJson      Json         @map("calculation_json")
  scheduledAt          DateTime     @default(now()) @map("scheduled_at")
  paidAt               DateTime?    @map("paid_at")
  externalReference    String?      @map("external_reference")
  failureReason        String?      @map("failure_reason")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([partnerId, status])
  @@index([status, scheduledAt])
  @@map("partner_payouts")
}

model InvoiceSequence {
  year      Int      @id
  lastSeq   Int      @default(0) @map("last_seq")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("invoice_sequences")
}

enum TrackingStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model TrackingSession {
  id               Int            @id @default(autoincrement())
  publicId         String         @unique @default(uuid())
  bookingId        Int            @unique @map("booking_id")
  partnerId        Int            @map("partner_id")
  customerId       Int            @map("customer_id")
  currentLatitude  Float          @map("current_latitude")
  currentLongitude Float          @map("current_longitude")
  heading          Float?
  speed            Float?
  etaMinutes       Int?           @map("eta_minutes")
  status           TrackingStatus @default(ACTIVE)
  startedAt        DateTime       @default(now()) @map("started_at")
  endedAt          DateTime?      @map("ended_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  partner  Partner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([bookingId, status])
  @@index([partnerId, status])
  @@map("tracking_sessions")
}

model NotificationLog {
  id                Int      @id @default(autoincrement())
  publicId          String   @unique @default(uuid())
  bookingId         Int?     @map("booking_id")
  recipientId       Int      @map("recipient_id")
  channel           String
  provider          String
  templateId        String   @map("template_id")
  providerReference String?  @map("provider_reference")
  recipient         String
  status            String   @default("SENT")
  errorCode         String?  @map("error_code")
  sentAt            DateTime @default(now()) @map("sent_at")
  createdAt         DateTime @default(now()) @map("created_at")

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([recipientId, status])
  @@index([channel, status])
  @@map("notification_logs")
}

model DeviceToken {
  id         Int      @id @default(autoincrement())
  publicId   String   @unique @default(uuid())
  userId     Int      @map("user_id")
  deviceId   String   @map("device_id")
  platform   String
  token      String   @unique
  appVersion String?  @map("app_version")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@map("device_tokens")
}






